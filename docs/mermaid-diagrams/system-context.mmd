  theme: base
  themeVariables:
    primaryColor: "#EDF2F9"
    primaryBorderColor: "#CBD9EA"
    primaryTextColor: "#3F4A58"
    lineColor: "#BEC9D9"
    secondaryColor: "#EEF0F4"
    secondaryBorderColor: "#DADEE6"
    tertiaryColor: "#ECF3ED"
    tertiaryBorderColor: "#CDDECE"
    clusterBkg: "#F8FAFD"
    clusterBorder: "#E2E8F1"
    noteBkgColor: "#FAF7EE"
    noteBorderColor: "#E8DEC8"
    messageTextColor: "#3F4A58"
    compositeBackground: "#F8FAFD"
    compositeTitleBackground: "#EDF2F9"
    altBackground: "#F8FAFD"
    actorTextColor: "#3F4A58"
    signalTextColor: "#3F4A58"
