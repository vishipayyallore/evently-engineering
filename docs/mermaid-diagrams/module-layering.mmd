---
config:
  theme: base
  themeVariables:
    primaryColor: "#EAF1FB"
    primaryBorderColor: "#B7CDE8"
    primaryTextColor: "#33475B"
    lineColor: "#9FB8D6"
    secondaryColor: "#EDE7F6"
    secondaryBorderColor: "#C6BCE0"
    tertiaryColor: "#E8F5E9"
    tertiaryBorderColor: "#BBD9BE"
    clusterBkg: "#F5F8FD"
    clusterBorder: "#CBD9EC"
    noteBkgColor: "#FFF8E1"
    noteBorderColor: "#EAD9A0"
    messageTextColor: "#5B6B7B"
    fontFamily: "Segoe UI, Roboto, Helvetica, Arial, sans-serif"
---
%% Per-module layering. Dependencies point inward; Domain depends on nothing but Common.Domain.
%% Enforced by LayerTests (NetArchTest) once Phase 2 architecture tests are in place.
flowchart TB
    presentation["Presentation<br/>minimal-API endpoints, integration-event handlers,<br/>Permissions, Tags, sagas"]
    application["Application<br/>commands, queries, handlers, validators,<br/>domain-event handlers, abstraction interfaces"]
    infrastructure["Infrastructure<br/>DbContext, EF configs, repositories,<br/>module DI, outbox/inbox jobs, external clients"]
    domain["Domain<br/>aggregates (Entity), domain events,<br/>errors, repository interfaces"]
    commonDomain["Common.Domain"]

    presentation --> application
    application --> domain
    infrastructure --> application
    infrastructure --> presentation
    infrastructure --> domain
    domain --> commonDomain

    %% forbidden: Application -> Infrastructure/Presentation, Presentation -> Infrastructure,
    %% Domain -> anything but Common.Domain
